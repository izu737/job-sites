{
  "manifest_version": 3,
  "name": "Vidpitch Recorder",
  "version": "0.1.0",
  "description": "Record your screen, get a share link, and drop an animated GIF preview straight into Gmail.",
  "action": {
    "default_title": "Record a video",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "run_at": "document_idle"
    }
  ]
}
