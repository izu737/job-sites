# Public HTTPS address of this server. Gmail must be able to load the GIF from here.
PUBLIC_URL=https://videos.yourdomain.com

# Long random secret. Paste the same value into the extension settings.
# Leave unset in local development and one is generated in data/api-token.txt.
API_TOKEN=

# Shown on the video page and on the booking button.
OWNER_NAME=Your Name

# Your calendar link (Calendly, Cal.com, Google booking page...).
BOOKING_URL=https://cal.com/you/intro
CTA_LABEL=Book a call
CTA_HEADLINE=Want to talk this through?
CTA_SUBTEXT=Pick a time that works for you. It takes 10 seconds.
# Seconds before the end when the booking button slides onto the video.
CTA_LEAD_SECONDS=6

# Where videos and the database live. Must be on a persistent disk.
DATA_DIR=/data
PORT=8787
MAX_UPLOAD_MB=1024
